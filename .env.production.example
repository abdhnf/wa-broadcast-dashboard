APP_NAME="WA Broadcast Suite"
# Untuk server produksi: ganti ke production dan matikan debug.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://blast.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database: MySQL/MariaDB (bukan SQLite).
# SESSION_DRIVER, CACHE_STORE, dan QUEUE_CONNECTION di bawah memakai tabel,
# jadi database ini WAJIB sudah dimigrasi (php artisan migrate --force) sebelum
# aplikasi dipakai. Jika belum, pengguna akan terlempar balik ke halaman login
# tanpa pesan galat yang jelas.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wa_blast
DB_USERNAME=wa_blast
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WA API Gateway
# ---------------------------------------------------------------------------
# Dipakai SERVER dashboard untuk memverifikasi API key pemilik data CRM.
# Alamat internal/localhost karena request berangkat dari mesin dashboard sendiri.
WA_API_BASE=http://127.0.0.1:3100/api/v1

# Dipakai BROWSER pengguna, jadi harus alamat yang dapat dijangkau dari luar
# (domain publik atau IP LAN). Nilainya IKUT TER-BUNDLE ke JavaScript publik —
# jangan pernah menaruh rahasia/token di sini.
#
# PENTING: Vite menanam nilai ini saat BUILD, bukan saat runtime.
# Setiap kali diubah, jalankan ulang: npm run build
VITE_WA_API_BASE="https://api.blast.example.com/api/v1"

VITE_APP_NAME="${APP_NAME}"
